    invaders-4.bin
)

set(REQUIRED_INVADERS_FILES
    "${VT100_BASE_ROM}"
    "${VT100_BASE_SYMBOLS}"
    "${INVADERS_BASE_ROM}"
    "${INVADERS_AVO_ROM}"
    "${INVADERS_BASE_SYMBOLS}"
