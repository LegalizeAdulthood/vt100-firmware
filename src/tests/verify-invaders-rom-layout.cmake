file(READ "${INVADERS_AVO_ROM}" INVADERS_AVO_SETUP_HOOK HEX OFFSET 12 LIMIT 3)
string(TOUPPER "${INVADERS_AVO_SETUP_HOOK}" INVADERS_AVO_SETUP_HOOK)
